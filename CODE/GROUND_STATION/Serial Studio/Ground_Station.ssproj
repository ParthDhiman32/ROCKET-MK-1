            "painterCode": "function paint(ctx, width, height) {\n    var stateNum = datasets[0].value;\n\n    // Clear canvas background\n    ctx.fillStyle = \"#1a1a1a\";\n    ctx.fillRect(0, 0, width, height);\n\n    var statusTitle = \"\";\n    var statusSub = \"\";\n    var bgColor = \"#00cc66\"; \n\n    switch (stateNum) {\n        case 1:\n            statusTitle = \"LAUNCH DETECTED\";\n            statusSub = \"State 1 | Nominal Ascent\";\n            bgColor = \"#009933\";\n            break;\n        case 2:\n            statusTitle = \"APOGEE REACHED\";\n            statusSub = \"State 2 | Peak Altitude\";\n            bgColor = \"#0044cc\";\n            break;\n        case 3:\n            statusTitle = \"PARACHUTE DEPLOYED\";\n            statusSub = \"State 3 | Drogue/Main Active\";\n            bgColor = \"#0077aa\";\n            break;\n        case 4:\n            statusTitle = \"CHUTE DEPLOY FAILURE\";\n            statusSub = \"WARNING: DEPLOYMENT ERROR\";\n            bgColor = \"#b35900\";\n            break;\n        case 5:\n            statusTitle = \"OUT OF TRAJECTORY\";\n            statusSub = \"WARNING: DRIFT DETECTED\";\n            bgColor = \"#b35900\";\n            break;\n        case 6:\n            // Strobe warning effect for Hard Deceleration\n            var isVisible = Math.floor(Date.now() / 250) % 2 === 0;\n            bgColor = isVisible ? \"#cc0000\" : \"#330000\";\n            statusTitle = \"⚠️ HARD DECELERATION ⚠️\";\n            statusSub = \"TERRAIN TERRAIN - PULL UP\";\n            break;\n        case 7:\n            statusTitle = \"MAIN CHUTE RELEASE\";\n            statusSub = \"State 7 | Final Descent\";\n            bgColor = \"#0077aa\";\n            break;\n        case 8:\n            statusTitle = \"DESCENT STABILIZED\";\n            statusSub = \"State 8 | Stable Sink Rate\";\n            bgColor = \"#009933\";\n            break;\n        case 9:\n            statusTitle = \"TOUCHDOWN DETECTED\";\n            statusSub = \"State 9 | Ground Impact\";\n            bgColor = \"#404040\";\n            break;\n        case 10:\n            statusTitle = \"MISSION COMPLETE\";\n            statusSub = \"State 10 | Safe Shutdown\";\n            bgColor = \"#262626\";\n            break;\n        default:\n            statusTitle = \"STANDBY / INIT\";\n            statusSub = \"Waiting for Flight Sequence\";\n            bgColor = \"#333333\";\n            break;\n    }\n\n    // Render background color box\n    ctx.fillStyle = bgColor;\n    ctx.fillRect(0, 0, width, height);\n\n    // Render primary title\n    ctx.fillStyle = \"#FFFFFF\";\n    ctx.font = \"bold 18px sans-serif\";\n    ctx.textAlign = \"center\";\n    ctx.textBaseline = \"middle\";\n    ctx.fillText(statusTitle, width / 2, height / 2 - 10);\n\n    // Render subtitle\n    ctx.font = \"13px sans-serif\";\n    ctx.fillStyle = stateNum === 6 ? \"#ffcccc\" : \"#e0e0e0\";\n    ctx.fillText(statusSub, width / 2, height / 2 + 16);\n}",
            "title": "Canvas Widget",
            "uniqueId": 85,
            "widget": "painter"
        }
    ],
